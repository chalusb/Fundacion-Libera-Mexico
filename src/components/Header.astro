---
export interface Props {
  textColor?: string;
  buttonColor?: string;
  buttonTextColor?: string;
}
---

<header class="bg-white shadow-sm fixed top-0 left-0 w-full z-50">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div class="flex justify-between items-center h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <div class="flex flex-col max-h-16">
          <img src="/logo.png" alt="Logo" class="h-12" />
        </div>
      </a>

      <!-- CTA -->
      <div class="flex items-center">
        <a
          href="https://alwayson.recaudia.com/liberamexico/donor"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex bg-[#EC4899] text-white px-5 py-2 sm:px-6 sm:py-2.5 lg:px-8 lg:py-3 rounded-full font-semibold text-xs sm:text-sm tracking-wide hover:opacity-90 transition-opacity duration-200 shadow-sm"
        >
          DONA AHORA
        </a>
      </div>
    </div>
  </div>
</header>
