const allyLogoPath = (filename: string) =>
  filename.startsWith("/") ? filename : `/images/allies/${encodeURIComponent(filename)}`;
---

<section class="w-full mx-auto overflow-hidden relative bg-white py-14 sm:py-20">
  <div class="max-w-7xl mx-auto relative px-4">
    <div class="text-center">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#214296]">
        NUESTROS ALIADOS
      </h2>
      <img
        src="/images/decores/2.png"
        alt=""
        class="w-auto h-10 sm:h-12 object-contain mx-auto -mt-2"
        loading="lazy"
      />
    </div>

    <div class="mt-10 grid gap-6 sm:gap-8 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
      {allies.map((ally) => (
        <figure class="ally-card flex flex-col items-center text-center bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow px-4 py-6">
          <div class="ally-logo flex items-center justify-center h-20 sm:h-24 lg:h-28 w-full">
            <img
              src={allyLogoPath(ally.logo)}
              alt={ally.name}
              class="max-h-full w-auto object-contain"
              loading="lazy"
            />
          </div>
          <figcaption class="mt-3 text-xs sm:text-sm font-semibold text-slate-700">
            {ally.name}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
