---
type Member = {
  name: string;
  role: string;
  image?: string;
};

type TeamSection = {
  title: string;
  gridClass: string;
  members: Member[];
};

const titleImage = "/images/imgcompleta/img_completa-4-removebg-preview.png";
const avatarBg = "/images/web_decore-4.webp";
const defaultAvatar = "/images/6997662.png";

const imagePath = (filename?: string) => {
  if (!filename) return defaultAvatar;
  if (filename.startsWith("/")) return filename;
  return `/images/equipo/${encodeURIComponent(filename)}`;
};

